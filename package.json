{
  "name": "mole-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight React component library for MoleDAO.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @moledao/playground dev",
    "build": "corepack pnpm --filter moledao build && corepack pnpm --filter @moledao/playground build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm --filter moledao test",
    "test:run": "corepack pnpm --filter moledao test:run",
    "test:coverage": "corepack pnpm --filter moledao test:coverage",
    "check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test:run && corepack pnpm build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "corepack pnpm --filter moledao build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
